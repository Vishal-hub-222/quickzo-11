# Required by the deployment platform and the Express server.
PORT=4000

# Required for product storage and image uploads.
MONGO_URL=your_mongodb_connection_string
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Keep this file in the backend only. Never place this key in frontend code.
OPENAI_API_KEY=your_openai_api_key
# Optional: override the model used for product-description generation.
OPENAI_MODEL=gpt-4o-mini
